# 해담시청 SOAR — 이 파일을 .env로 복사하고 값을 채운다. .env는 커밋하지 않는다.
# 무작위 값 만들기:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# 값이 비어 있으면 docker compose가 변수 이름을 대며 기동을 거부한다.

# ── pfSense ──
# 설정 마법사에서 정한 admin 비밀번호(대응 도구 설치·설정 확인에 씀)
PFSENSE_ADMIN_PASSWORD=change-me
# n8n 전용 SSH 키(infra/pfsense/INSTALL.md 4절). 프로젝트 폴더 기준 경로
PF_SSH_PRIVATE_KEY_FILE=.local/haedam-pf

# ── 서버(포털·MySQL·티켓 저장소) ──
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
PORTAL_ADMIN_USERNAME=haedam_admin
# 10자 이상
PORTAL_ADMIN_PASSWORD=change-me
# n8n → 포털 대응 API (X-Response-Key)
PORTAL_RESPONSE_KEY=change-me
# n8n → 티켓 저장소 (X-Response-Key)
TICKET_STORE_KEY=change-me

# ── Graylog ──
GRAYLOG_ADMIN_PASSWORD=change-me
# GRAYLOG_ADMIN_PASSWORD의 SHA-256:  python -c "import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" <비밀번호>
GRAYLOG_ROOT_PASSWORD_SHA2=replace-with-sha256-of-admin-password
# 16자 이상, 한 번 정하면 바꾸지 않는다
GRAYLOG_PASSWORD_SECRET=change-me-to-a-long-random-string

# ── n8n ──
# Graylog 알림·실행기 → n8n 웹훅 (X-Haedam-Key)
N8N_WEBHOOK_KEY=change-me
# 자격 증명 암호화 키. 볼륨을 만든 뒤에는 바꾸지 않는다
N8N_ENCRYPTION_KEY=change-me
# (선택) 대응 알림을 받을 Discord 채널 웹훅. 비우면 알림만 건너뛰고 대응은 그대로 진행
DISCORD_WEBHOOK_URL=

# ── Wazuh ──
# 정책: 대·소문자·숫자·기호를 모두 넣고 8~64자. $·따옴표는 쓰지 않는다.
# 처음 설치: `python infra/wazuh/make_users.py`로 internal_users.yml을 만든 뒤 띄운다.
# 이미 띄운 뒤 바꿀 때는 infra/wazuh/README.md의 "비밀번호 교체"를 따른다(볼륨은 첫 생성 때만 값을 받는다).
WAZUH_INDEXER_PASSWORD=change-me
WAZUH_DASHBOARD_PASSWORD=change-me
WAZUH_API_PASSWORD=change-me
