ft":455.04,"top":393.6,"width":368.64,"height":124.8}},{"id":"sh/p0ru503u","kind":"textbox","text":"401","position":{"left":483.84,"top":412.8,"width":124.8,"height":81.6}},{"id":"sh/xwnupgvy","kind":"textbox","text":"잠긴 담당자 새 로그인","position":{"left":613.44,"top":420.48,"width":201.6,"height":38.4}},{"id":"sh/wvetgbud","kind":"textbox","text":"거부","position":{"left":613.44,"top":458.88,"width":201.6,"height":33.6}},{"id":"sh/bu5cnqd8","kind":"shape","position":{"left":852.48,"top":393.6,"width":368.64,"height":124.8}},{"id":"sh/atwbelcn","kind":"textbox","text":"401","position":{"left":881.28,"top":412.8,"width":124.8,"height":81.6}},{"id":"sh/lk7ut0va","kind":"textbox","text":"쥐고 있던 세션","position":{"left":1010.88,"top":420.48,"width":201.6,"height":38.4}},{"id":"sh/kjytkvup","kind":"textbox","text":"세션 회수","position":{"left":1010.88,"top":458.88,"width":201.6,"height":33.6}},{"id":"sh/jypcrqd4","kind":"shape","position":{"left":57.6,"top":547.2,"width":1164.48,"height":76.8}},{"id":"sh/yxgbilcj","kind":"shape","position":{"left":81.6,"top":558.72,"width":53.76,"height":53.76}},{"id":"im/q9kbeh8v","kind":"image","position":{"left":96.12,"top":573.24,"width":24.73,"height":24.73}},{"id":"sh/0nut8rul","kind":"textbox","text":"권한이 있어도 비정상적인 양이면 멈추고, 판단은 관리자가 한다.","position":{"left":158.4,"top":547.2,"width":1036.8,"height":76.8}},{"id":"sh/q9srixs3","kind":"textbox","text":"10","position":{"left":1174.08,"top":670.08,"width":48,"height":28.8}}],"notes":{"text":"H4는 내부자 시나리오다. 담당자는 민원을 볼 권한이 있어 403 같은 거부 신호가 없다. 그래서 담당자의 민원 상세 조회가 10분에 20건을 넘으면 n8n(haedam-38)이 계정을 잠그고 세션을 회수한다. 기준선(상세 조회 8건)은 티켓이 없었다. 3회 모두 새 로그인·쥐고 있던 세션 401, 시민 200, 관리자 해제 뒤 200·티켓 restored. 첫 회차는 잠금은 됐지만 티켓 기록이 멱등키 길이(7자)로 거부됐다. 새 n8n에서 실행 번호가 작아 생긴 버그로 H3도 같이 고쳤다. 설계 초안의 역할 강등 대신 검증된 계정 잠금을 썼고, 강등은 후속이다. Discord 수신은 미검증."}}