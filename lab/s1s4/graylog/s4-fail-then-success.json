{
  "title": "S4 실패 뒤 성공 (username+src_ip)",
  "description": "A S4. 10분 안 같은 username+src_ip에서 로그인 실패(401)·성공(200)이 모두 있고 합계 6건 이상. 순서 요구 안 함, 429 제외. 기준: docs/capstone/A-S1-S4-정상패턴.md §1",
  "priority": 3,
  "alert": true,
  "config": {
    "type": "aggregation-v1",
    "query": "source:haedam-portal AND ((rule:\"login-bruteforce\" AND status:401) OR (rule:\"login-success\" AND status:200))",
    "query_parameters": [],
    "filters": [],
    "streams": ["REPLACE_haedam-portal_stream_id"],
    "group_by": ["username", "src_ip"],
    "series": [
      {"id": "count()", "type": "count"},
      {"id": "card(rule)", "type": "card", "field": "rule"}
    ],
    "conditions": {
      "expression": {
        "expr": "&&",
        "left": {
          "expr": ">",
          "left": {"expr": "number-ref", "ref": "card(rule)"},
          "right": {"expr": "number", "value": 1}
        },
        "right": {
          "expr": ">",
          "left": {"expr": "number-ref", "ref": "count()"},
          "right": {"expr": "number", "value": 5}
        }
      }
    },
    "search_within_ms": 600000,
    "execute_every_ms": 60000,
    "use_cron_scheduling": false,
    "event_limit": 100
  },
  "field_spec": {
    "username": {"data_type": "string", "providers": [{"type": "template-v1", "template": "${source.username}", "require_values": true}]},
    "src_ip": {"data_type": "string", "providers": [{"type": "template-v1", "template": "${source.src_ip}", "require_values": true}]},
    "case_id": {"data_type": "string", "providers": [{"type": "template-v1", "template": "S4", "require_values": true}]}
  },
  "key_spec": ["username", "src_ip"],
  "notification_settings": {"grace_period_ms": 600000, "backlog_size": 20},
  "notifications": [],
  "storage": [{"type": "persist-to-streams-v1", "streams": ["000000000000000000000002"]}]
}
