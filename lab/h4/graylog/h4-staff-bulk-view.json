{
  "title": "H4 staff bulk petition view",
  "description": "Same staff account opens more than 19 petition details within ten minutes (insider bulk lookup).",
  "priority": 2,
  "alert": true,
  "config": {
    "type": "aggregation-v1",
    "query": "source:haedam-portal AND event_type:\"petition.viewed\"",
    "query_parameters": [], "filters": [], "streams": ["REPLACE_haedam-portal_stream_id"], "stream_categories": [],
    "group_by": ["username"], "series": [{"type": "count", "id": "count()", "field": null}],
    "conditions": {"expression": {"expr": ">", "left": {"expr": "number-ref", "ref": "count()"}, "right": {"expr": "number", "value": 19}}},
    "search_within_ms": 600000, "execute_every_ms": 60000, "use_cron_scheduling": false, "cron_expression": null, "cron_timezone": null, "event_limit": 100
  },
  "field_spec": {
    "username": {"data_type": "string", "providers": [{"type": "template-v1", "template": "${source.username}", "require_values": true}]},
    "case_id": {"data_type": "string", "providers": [{"type": "template-v1", "template": "H4", "require_values": true}]}
  },
  "key_spec": ["username"],
  "notification_settings": {"grace_period_ms": 600000, "backlog_size": 20},
  "notifications": [],
  "storage": [{"type": "persist-to-streams-v1", "streams": ["000000000000000000000002"]}]
}
