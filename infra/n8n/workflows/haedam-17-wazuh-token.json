   {
    "id": "4bd26748-6766-58d2-9a8d-5cf6ea5a7732",
    "name": "전송 준비",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     720,
     0
    ],
    "parameters": {
     "jsCode": "// 토큰은 이 실행 안에서만 쓰고 결과에 담지 않는다. 이 하위 워크플로는 실행 기록을 저장하지 않는다.\nconst tok = String($input.first().json.data || $input.first().json.body || '').trim();\nconst p = $('입력 정리').first().json;\nif (!tok) return [{ json: { stop: true, summary: { auth_failed: true } } }];\nreturn [{ json: { token: tok, url: `${p.api}/active-response?agents_list=${p.agent}`,\n  body: JSON.stringify({ command: p.script, arguments: [p.file_key, p.run_id] }) } }];\n"
    }
   },
