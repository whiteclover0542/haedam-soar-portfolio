   {
    "id": "b532ea6a-331b-5aed-8d73-23b1db441951",
    "name": "입력 정리",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     240,
     0
    ],
    "parameters": {
     "jsCode": "// 입구 검증: 이 하위 워크플로는 haedam-15가 검증한 실행 의도(execute === true)와 고정된 대상만 받는다.\n// 허용 대상·명령을 상수로 두고 입력과 같은지 확인한다. 어긋나거나 실행 의도가 없으면 로그인(자격 증명 사용)과 AR 전에 멈춘다.\nconst b = $input.first().json;\nconst ALLOWED = { api: 'https://10.250.0.4:55000', agent: '010', script: '!s7-restore-ar' };\nconst reject = (reason) => [{ json: { stop: true, summary: { rejected: reason } } }];\nif (b.execute !== true) return reject('not_authorized');\nif (b.api !== ALLOWED.api || b.agent !== ALLOWED.agent || b.script !== ALLOWED.script) return reject('target_not_allowed');\nconst key = b.file_key;\nif (typeof key !== 'string' || !/^[A-Za-z0-9._\\-\\/]{1,200}$/.test(key) || key.startsWith('/') || key.split('/').includes('..')) return reject('bad_file_key');\nif (typeof b.run_id !== 'string' || !/^(S7-\\d{8}-[A-Z0-9]{2,12}|n8n-[A-Za-z0-9_.-]{1,40})$/.test(b.run_id)) return reject('bad_run_id');\nreturn [{ json: { api: ALLOWED.api, agent: ALLOWED.agent, script: ALLOWED.script, file_key: key, run_id: b.run_id } }];\n"
    }
   },
   {
    "id": "63dbe4d5-098b-5762-a3aa-bda6aa9fd0e7",
    "name": "입력 통과?",
    "type": "n8n-nodes-base.if",
    "typeVersion": 2.2,
    "position": [
     360,
     0
    ],
    "parameters": {
     "conditions": {
      "options": {
       "caseSensitive": true,
       "leftValue": "",
       "typeValidation": "strict",
