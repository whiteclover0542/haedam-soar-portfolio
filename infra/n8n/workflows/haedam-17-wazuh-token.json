   {
    "id": "01079cac-77f7-5c2c-a781-48d92534e9b1",
    "name": "응답 요약",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     1440,
     -60
    ],
    "parameters": {
     "jsCode": "// 부모(저장되는 haedam-15)로 넘기는 값은 허용된 형태만 담는다: 숫자·고정 단어·3자리 agent ID.\n// 응답 원문(detail·title·message)이나 오류 문자열은 토큰이 섞일 수 있어 길이만 줄여 넘기지 않고 아예 넘기지 않는다.\nconst j = $input.first().json;\nconst d = (j.body && j.body.data) || {};\nconst status = Number.isInteger(j.statusCode) ? j.statusCode : null;\nconst failed = Array.isArray(d.failed_items) ? d.failed_items : [];\nconst ids = [];\nfor (const f of failed) for (const id of [].concat((f && f.id) || [])) if (/^\\d{3}$/.test(String(id)) && ids.length < 5) ids.push(String(id));\nconst reason = status === null ? 'network' : status === 401 ? 'unauthorized' : status === 403 ? 'forbidden'\n  : status >= 500 ? 'server_error' : status >= 400 ? 'client_error' : '';\nreturn [{ json: { summary: { status, affected: Number.isInteger(d.total_affected_items) ? d.total_affected_items : 0,\n  failed_count: failed.length, failed_ids: ids, reason } } }];\n"
    }
   },
   {
