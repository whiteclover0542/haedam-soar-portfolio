                    880,
                    0
                ],
                "parameters": {
                    "jsCode": "const r=$input.first().json; const x=r.ctx||{}; const accepted=r.ok===true&&typeof r.ticket_id==='string'&&['open','responding','verified'].includes(r.status); return [{json:{ok:accepted,proceed:accepted,verdict:accepted?'ticket_recorded':'ticket_store_failed_no_action',ctx:accepted?{...x,ticket_id:r.ticket_id}:x,error:accepted?null:r.error||null}}];"
                }
            },
