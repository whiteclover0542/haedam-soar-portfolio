                "name": "Validate H3",
                "type": "n8n-nodes-base.code",
                "typeVersion": 2,
                "position": [
                    220,
                    0
                ],
                "parameters": {
                    "jsCode": "const t=$input.first().json.body||{}; const required=['event_id','asset_id','username','petition_id','revision_id','case_id']; const missing=required.filter(k=>!t[k]); if(missing.length||t.case_id!=='H3') return [{json:{ok:false,proceed:false,verdict:'invalid_input',missing,detail:'case_id must be H3'}}]; const cfg={dry_run:t.dry_run!==false,store_real:t.store_real===true}; return [{json:{ok:true,proceed:true,ctx:{...t,cfg,seat:'C',group_key:t.username,title:'H3 petition integrity change'}}}];"
                }
            },
            {
                "id": "ticket-input",
                "name": "Ticket detected input",
                "type": "n8n-nodes-base.code",
                "typeVersion": 2,
                "position": [
                    440,
                    0
                ],
                "parameters": {
                    "jsCode": "const x=$input.first().json.ctx; return [{json:{ctx:x,mode:'record',stage:'detected',seat:x.seat,case_id:x.case_id,group_key:x.group_key,title:x.title,asset_id:x.asset_id,src_ip:null,username:x.username,event_ids:[x.event_id],action:null,idempotency_key:`${$execution.id}-detected`}}];"
                }
            },
