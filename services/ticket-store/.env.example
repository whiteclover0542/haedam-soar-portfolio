# Copy to .env and set a new random key (never commit .env).
# The same value goes only into the D n8n Header Auth credential, handed over in person.
TICKET_STORE_KEY=
# 1 = load synthetic sample tickets (data_origin=sample) on start
TICKET_STORE_SAMPLES=0
# Academy default; use 127.0.0.1 for isolated home checks. Do not use 0.0.0.0.
TICKET_BIND_IP=10.250.0.3
DASHBOARD_ORIGIN=http://127.0.0.1:8089
