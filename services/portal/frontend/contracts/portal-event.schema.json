{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:nobugs:haedam:portal-event:1.0",
  "type":"object","additionalProperties":false,
  "required":["schema_version","event_id","timestamp","source","event_type","username","src_ip","asset_id","outcome","details"],
  "properties":{
    "schema_version":{"const":"1.0"},"event_id":{"type":"string","format":"uuid"},
    "timestamp":{"type":"string","format":"date-time"},"source":{"const":"haedam-portal"},
    "event_type":{"enum":["auth.login_succeeded","auth.login_failed","auth.account_locked","auth.account_unlocked","auth.password_reset","iam.role_changed","web.not_found","web.request","web.file_access","web.ip_blocked","web.ip_unblocked","petition.created","petition.updated","petition.create_refused","auth.posting_restricted","auth.posting_allowed"]},
    "username":{"type":["string","null"],"maxLength":40},
    "src_ip":{"type":"string","anyOf":[{"format":"ipv4"},{"format":"ipv6"}]},
    "asset_id":{"type":"string","minLength":1},"outcome":{"enum":["success","failure","denied"]},
    "details":{"type":"object","additionalProperties":false,"required":["resource","method","status"],"properties":{
      "resource":{"type":"string","maxLength":120},"method":{"enum":["GET","POST","PATCH","DELETE","PUT","HEAD","OPTIONS","OTHER"]},"status":{"type":"integer","minimum":100,"maximum":599},"previous_role":{"enum":["citizen","staff","admin"]},"new_role":{"enum":["citizen","staff","admin"]},
      "file_key":{"type":"string","minLength":1,"maxLength":200,"pattern":"^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])(?![A-Za-z]:)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))(?:[^/?#\\\\]+/)*[^/?#\\\\]+$"},
      "target_ip":{"type":"string","anyOf":[{"format":"ipv4"},{"format":"ipv6"}]},
      "actor_user_id":{"type":"integer"},"actor_username":{"type":"string","maxLength":40},"reason_code":{"enum":["false_positive"]}
    }}
  }
}
