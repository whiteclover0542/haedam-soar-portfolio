{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nobugs-aleph.local/contracts/portal-admin-users.schema.json",
  "title": "Portal administrator user listing response",
  "type": "object",
  "additionalProperties": false,
  "required": ["success", "data"],
  "properties": {
    "success": { "const": true },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "total", "page", "page_size", "pages", "summary"],
      "properties": {
        "items": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/user" } },
        "total": { "type": "integer", "minimum": 0 },
        "page": { "type": "integer", "minimum": 1 },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 50 },
        "pages": { "type": "integer", "minimum": 1 },
        "summary": {
          "type": "object", "additionalProperties": false,
          "required": ["scope", "total", "roles", "locked", "unlocked"],
          "properties": {
            "scope": { "const": "search" },
            "total": { "type": "integer", "minimum": 0 },
            "locked": { "type": "integer", "minimum": 0 },
            "unlocked": { "type": "integer", "minimum": 0 },
            "roles": {
              "type": "object", "additionalProperties": false,
              "required": ["citizen", "staff", "admin"],
              "properties": {
                "citizen": { "type": "integer", "minimum": 0 },
                "staff": { "type": "integer", "minimum": 0 },
                "admin": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "user": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "username", "display_name", "role", "department", "locked", "created_at"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "username": { "type": "string", "minLength": 3, "maxLength": 40 },
        "display_name": { "type": "string", "minLength": 2, "maxLength": 30 },
        "role": { "enum": ["citizen", "staff", "admin"] },
        "department": { "type": "string", "maxLength": 40 },
        "locked": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
