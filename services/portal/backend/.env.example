# Copy values into the shell or use tools/start.ps1. Never commit actual credentials.
# SQLite is local-only. For MySQL: mysql+pymysql://USER:PASSWORD@HOST/haedam?charset=utf8mb4
DATABASE_URL=sqlite:///haedam.sqlite3
FRONTEND_DIST=../haedam-portal-frontend/dist
COOKIE_SECURE=0
GELF_ENABLED=0
GELF_HOST=127.0.0.1
GELF_PORT=12201
GELF_TRANSPORT=udp
EVENT_LOG_PATH=instance/events.jsonl
# Enable only after configuring the actual management network. Empty means disabled.
RESPONSE_API_KEY=
RESPONSE_ALLOWED_CIDRS=
DASHBOARD_URL=
